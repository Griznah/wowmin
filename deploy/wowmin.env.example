# WoWMin listener and HTTP Basic Authentication (required)
WOWMIN_HOST=0.0.0.0
WOWMIN_PORT=3000
WOWMIN_USERNAME=admin
WOWMIN_PASSWORD=replace-with-a-strong-password
WOWMIN_DATA_DIR=/var/lib/wowmin
# Generated unit models, spell art, and icons. The systemd service can write
# under its StateDirectory even with ProtectSystem=strict.
WOWMIN_MODEL_CACHE_DIR=/var/lib/wowmin/models

# Optional direct DC Test Deck URL.
# Omit this to derive http(s)://<current-browser-host>:8790/.
# WOWMIN_DUNGEON_CLEAR_URL=http://server-address:8790/

# Optional server-managed connections. Set SOAP username/password and the
# shared DB password to enable managed mode. The server owns these connections,
# retries unavailable services, and shares their status with every browser.
# WOWMIN_SOAP_HOST=127.0.0.1
# WOWMIN_SOAP_PORT=7878
# WOWMIN_SOAP_USERNAME=wowmin
# WOWMIN_SOAP_PASSWORD=replace-with-the-soap-password
# WOWMIN_DB_HOST=127.0.0.1
# WOWMIN_DB_PORT=3306
# WOWMIN_DB_USERNAME=acore
# WOWMIN_DB_PASSWORD=replace-with-the-database-password
# WOWMIN_WORLD_DB=acore_world
# WOWMIN_CHARACTERS_DB=acore_characters
# WOWMIN_ECONOMY_DB=acore_characters
# Optional per-service DB overrides; each falls back to WOWMIN_DB_* above.
# WOWMIN_WORLD_DB_HOST=127.0.0.1
# WOWMIN_WORLD_DB_PORT=3306
# WOWMIN_WORLD_DB_USERNAME=acore
# WOWMIN_WORLD_DB_PASSWORD=replace-with-the-world-database-password
# WOWMIN_CHARACTERS_DB_HOST=127.0.0.1
# WOWMIN_CHARACTERS_DB_PORT=3306
# WOWMIN_CHARACTERS_DB_USERNAME=acore
# WOWMIN_CHARACTERS_DB_PASSWORD=replace-with-the-characters-database-password
# WOWMIN_ECONOMY_DB_HOST=127.0.0.1
# WOWMIN_ECONOMY_DB_PORT=3306
# WOWMIN_ECONOMY_DB_USERNAME=acore
# WOWMIN_ECONOMY_DB_PASSWORD=replace-with-the-economy-database-password
# Optional managed reconnect backoff (milliseconds).
# WOWMIN_CONNECTION_RETRY_INITIAL_MS=5000
# WOWMIN_CONNECTION_RETRY_MAX_MS=60000
# WOWMIN_CONNECTION_HEALTH_MS=30000
# WOWMIN_WORLD_CONFIG=/path/to/azerothcore/env/dist/etc/worldserver.conf
# WOWMIN_LOG_DIR=/path/to/azerothcore/env/dist/bin

# Optional telemetry and session recording intervals (milliseconds)
# Shared poll interval for Live Map, Instance Watch, and session recording (ms, min 500)
# WOWMIN_TELEMETRY_POLL_MS=1000

# How often movement routes are sampled into session records (ms)
# WOWMIN_SESSION_ROUTE_INTERVAL_MS=5000

# How long a vanished session must stay absent before it is finalized (ms)
# Times below 10000 may not work as intended
# WOWMIN_SESSION_COMPLETION_GRACE_MS=15000

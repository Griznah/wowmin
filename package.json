{
  "name": "wow-admin",
  "version": "3.0.0",
  "description": "Web-based AzerothCore administration tool with SOAP, database editing, live worldserver telemetry, instance watch, and session replay",
  "scripts": {
    "build:ts": "node esbuild.config.js",
    "build:ts:watch": "node esbuild.config.js --watch",
    "build:css": "node scripts/build-css.js",
    "build:css:watch": "node scripts/build-css.js --watch",
    "extract:maps": "node scripts/extract-map-assets.mjs",
    "extract:icons": "node scripts/extract-player-icons.mjs",
    "start": "node dist/web-server.js",
    "start:web": "npm start",
    "dev": "npm run build && npm start",
    "build": "npm run build:ts && npm run build:css",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-*.cjs"
  },
  "keywords": [
    "azerothcore",
    "wow",
    "soap",
    "admin",
    "azerothcore-tools",
    "database-editor"
  ],
  "author": "scarecr0w12 <scarecr0w12@users.noreply.github.com>",
  "maintainers": [
    "Jellypowered <Jellypowered@gmail.com>"
  ],
  "homepage": "https://github.com/Jellypowered/wowmin",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.10.0",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@types/ssh2": "^1.15.5",
    "jpeg-js": "^0.4.4",
    "js-blp": "^1.0.5",
    "mysql2": "^3.6.0",
    "pngjs": "^7.0.0",
    "ssh2": "^1.17.0",
    "stormlib-js": "^0.1.1",
    "xml2js": "^0.6.2"
  }
}
